; Engine configuration file.
; Best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="3D Intersection Traffic Simulator"
run/main_scene="res://scenes/Intersection.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon=""

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/stretch/aspect="ignore"

[gui]

theme/custom_font="res://assets/fonts/NanumGothic-Regular.ttf"
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.53, 0.72, 0.9, 1)
